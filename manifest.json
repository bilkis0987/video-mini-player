{
  "manifest_version": 2,
  "name": "Mini Play Web",
  "version": "1.0.0",
  "description": "Video mini player - video tetap visible saat pindah tab atau minimize browser",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/player.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
